---
import Layout from "../layouts/Layout.astro";

const specialties = [
  { label: "VR Development", detail: "Full-cycle VR builds for PCVR and standalone, from prototype to shipped brand activation." },
  { label: "Simulation & Networking", detail: "Multiplayer and networked simulation systems, including geospatial (Cesium) integrations." },
  { label: "AI-Assisted Pipelines", detail: "ComfyUI-based generation pipelines for character and environment content." },
  { label: "Level & Systems Design", detail: "Gameplay systems and level design grounded in agile, team-based production." },
];
---
<Layout title="Home">
  <section class="hero">
    <h1>Senior Unreal Engine developer, <span class="grad">built for VR and simulation.</span></h1>
    <p class="hero-sub">
      7+ years shipping VR experiences, training simulations, and geospatial tools in UE5 and C++.
      Freelance under Propane Games — currently taking on new contract work.
    </p>
    <a class="cta" href="/contact">Get in touch</a>
  </section>

  <section class="specialties">
    {specialties.map((s) => (
      <div class="specialty">
        <h3>{s.label}</h3>
        <p>{s.detail}</p>
      </div>
    ))}
  </section>

  <section class="bio">
    <h2>About</h2>
    <p>
      Resourceful senior Unreal Engine developer and level designer with over seven years of
      experience specializing in VR development, simulation, and networking. I hold an AEC in
      Level and Game Design from Interdec College and work fluently in both French and English.
      My work spans PCVR brand activations, healthcare training simulations, a geospatial
      helicopter simulator built on Cesium, and heritage site experiences — with a growing focus
      on AI-assisted content pipelines to speed up asset and previz work.
    </p>
  </section>

  <section class="reel">
    <h2>Demo reel</h2>
    <div class="reel-grid">
      <div class="video-wrap">
        <iframe
          src="https://www.youtube.com/embed/MtKvIDYAfFk?wmode=transparent&rel=0"
          title="Propane Games demo reel"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
      <div class="video-wrap">
        <iframe
          src="https://www.youtube.com/embed/oyMxiVD2zH8?wmode=transparent&rel=0"
          title="Level design walkthrough"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 88px 0 60px;
      max-width: 640px;
    }
    .hero h1 {
      font-size: clamp(2.1rem, 4.4vw, 3rem);
      margin-bottom: 20px;
    }
    .hero h1 .grad {
      background: linear-gradient(135deg, var(--violet), var(--magenta));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-sub {
      color: var(--muted);
      font-size: 1.05rem;
      max-width: 520px;
      margin-bottom: 32px;
    }
    .cta {
      display: inline-block;
      padding: 13px 26px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--violet), var(--magenta));
      color: #fff;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.95rem;
      box-shadow: 0 0 0 rgba(124, 92, 255, 0);
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .cta:hover {
      box-shadow: 0 8px 30px var(--violet-soft);
      transform: translateY(-1px);
    }

    .specialties {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-bottom: 80px;
    }
    .specialty {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .specialty:hover {
      border-color: var(--violet-soft);
      transform: translateY(-2px);
    }
    .specialty h3 {
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 8px;
    }
    .specialty p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .bio, .reel { margin-bottom: 80px; }
    .bio h2, .reel h2 {
      font-size: 1.3rem;
      margin-bottom: 20px;
    }
    .bio p {
      max-width: 680px;
      color: var(--text);
    }

    .reel-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .video-wrap {
      position: relative;
      padding-top: 56.25%;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .video-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    @media (max-width: 640px) {
      .specialties { grid-template-columns: 1fr; }
      .reel-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
