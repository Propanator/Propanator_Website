---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Each project lives as a Markdown file in src/content/projects/ — add or
// edit projects by adding/editing files there, no need to touch this page.
// See src/content.config.ts for the field schema.
const entries = await getCollection("projects");
const projects = entries
  // Markdown body (anything written below the frontmatter) is auto-compiled
  // to HTML by the glob loader — no render() dance needed to pass it to the
  // client-side modal script as a plain string.
  .map((e) => ({ id: e.id, ...e.data, docsHtml: e.rendered?.html ?? "" }))
  .sort((a, b) => a.order - b.order);

const allTags = ["All", ...new Set(projects.flatMap((p) => p.tags))];
---
<Layout title="Projects" description="VR, simulation, and game development projects by Louis Charles La Manna.">
  <section class="page-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Projects built to <span>ship.</span></h1>
    <p>A selection of shipped VR and simulation work, from live interactive experiences to
      training and geospatial tools.</p>
  </section>

  <div class="filters" role="group" aria-label="Filter projects by category">
    {allTags.map((tag, i) => (
      <button class="filter-btn" data-tag={tag} aria-pressed={i === 0 ? "true" : "false"}>
        {tag}
      </button>
    ))}
  </div>

  <div class="timeline-bleed">
  <section class="project-list">
    {projects.map((p, i) => (
      <div class="timeline-row" data-side={i % 2 === 0 ? "left" : "right"}>
        <span class="timeline-dot" aria-hidden="true"></span>
        <article
          class="project"
          data-tags={p.tags.join(",")}
          data-project-id={p.id}
          tabindex="0"
          role="button"
          aria-label={`View details for ${p.title}`}
        >
          <div class="project-thumb">
            <img src={p.image} alt={p.title} />
          </div>
          <div class="project-body">
            <div class="tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <h2>{p.title}</h2>
            {(p.studio || p.platform || p.period) && (
              <p class="meta">{[p.studio, p.platform, p.period].filter(Boolean).join(" · ")}</p>
            )}
            <p class="summary">{p.summary}</p>
            <span class="view-more">View details →</span>
          </div>
        </article>
      </div>
    ))}
  </section>
  </div>

  <!-- Detail overlay -->
  <div class="modal-overlay" id="modalOverlay" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button class="modal-close" id="modalClose" aria-label="Close">✕</button>
      <div class="modal-image" id="modalImage"></div>
      <div class="modal-video" id="modalVideo"></div>
      <div class="modal-body">
        <div class="tags" id="modalTags"></div>
        <h2 id="modalTitle"></h2>
        <p id="modalDetails"></p>
        <dl>
          <div><dt>Role</dt><dd id="modalRole"></dd></div>
          <div><dt>Stack</dt><dd id="modalStack"></dd></div>
          <div id="modalStudioRow"><dt>Studio</dt><dd id="modalStudio"></dd></div>
          <div id="modalPlatformRow"><dt>Platform</dt><dd id="modalPlatform"></dd></div>
        </dl>
        <div class="modal-links" id="modalLinks"></div>
        <div class="modal-docs" id="modalDocs"></div>
      </div>
    </div>
  </div>

  <style>
    .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 36px; }
    .filter-btn {
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.85rem;
      color: var(--muted);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 16px;
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .filter-btn:hover { color: var(--text); border-color: var(--violet-soft); }
    .filter-btn[aria-pressed="true"] {
      color: #fff;
      background: linear-gradient(135deg, var(--violet), var(--magenta));
      border-color: transparent;
    }

    /* Timeline: a spine runs down the center, each row parks its project on
       alternating sides with a dot marking it on the spine, and the card
       slides in from its outer edge toward the line as it scrolls into view. */
    .project-list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 34px;
      margin-bottom: 70px;
      padding: 10px 0;
    }
    /* Breaks the timeline out of Layout's 960px <main> on desktop, same
       technique as the homepage's full-bleed sections — cards get real
       width to breathe into instead of wrapping to a tall stack of lines. */
    @media (min-width: 721px) {
      .timeline-bleed {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
      }
      .project-list {
        max-width: 1300px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 24px;
        padding-right: 24px;
      }
      .project { width: 48%; }
    }
    .project-list::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 3px;
      margin-left: -1.5px;
      background: linear-gradient(180deg, var(--violet), var(--magenta));
      border-radius: 999px;
      box-shadow: 0 0 24px rgba(124, 92, 255, 0.45);
      z-index: 0;
    }

    .timeline-row {
      position: relative;
      display: flex;
    }
    .timeline-row[data-side="left"] { justify-content: flex-start; }
    .timeline-row[data-side="right"] { justify-content: flex-end; }

    .timeline-dot {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      width: 14px;
      height: 14px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: linear-gradient(135deg, var(--violet), var(--magenta));
      box-shadow: 0 0 0 5px var(--bg), 0 0 18px rgba(255, 92, 168, 0.6);
    }

    .project {
      display: flex;
      align-items: stretch;
      gap: 0;
      width: 46%;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      opacity: 0;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, opacity 0.7s ease;
    }
    /* Resting transform is the entrance target — cards start pushed further
       toward their outer page edge and slide in to this position. */
    .timeline-row[data-side="right"] .project { flex-direction: row-reverse; }
    .timeline-row[data-side="left"] .project:not(.in-view) { transform: translateX(-70px); }
    .timeline-row[data-side="right"] .project:not(.in-view) { transform: translateX(70px); }
    .project.in-view {
      opacity: 1;
      transform: translateX(0);
      transition: border-color 0.2s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, opacity 0.7s ease;
    }
    .project:hover, .project:focus-visible {
      border-color: var(--violet-soft);
      transform: translateY(-3px);
      box-shadow: 0 20px 50px rgba(124, 92, 255, 0.18);
      outline: none;
    }

    .project-thumb {
      flex: 0 0 44%;
      position: relative;
      min-height: 220px;
    }
    .project-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .project-body {
      flex: 1;
      padding: 34px 38px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .tags { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
    /* :global so the same pill style reaches the modal's tags, which are
       created at runtime (see the modal script) and so aren't Astro-scoped. */
    .tags :global(.tag) {
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--violet);
      background: var(--violet-soft);
      border-radius: 999px;
      padding: 4px 12px;
    }
    .project h2 { font-size: 1.3rem; margin-bottom: 6px; }
    .meta { color: var(--muted); font-size: 0.8rem; margin-bottom: 12px; }
    .summary { color: var(--text); font-size: 0.95rem; line-height: 1.55; margin-bottom: 16px; }
    .view-more {
      font-family: var(--font-display);
      font-size: 0.85rem;
      color: var(--violet);
      font-weight: 600;
    }

    /* Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(8, 8, 14, 0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 50;
    }
    .modal-overlay.open { opacity: 1; pointer-events: auto; }

    .modal {
      background: var(--panel-raised);
      border: 1px solid var(--line);
      border-radius: 20px;
      max-width: 560px;
      width: 100%;
      /* dvh so iOS Safari's collapsing URL bar can't hide the bottom edge. */
      max-height: 85vh;
      max-height: 85dvh;
      overflow-y: auto;
      position: relative;
      transform: translateY(12px) scale(0.98);
      transition: transform 0.2s ease;
    }
    .modal-overlay.open .modal { transform: translateY(0) scale(1); }

    /* Short viewports (landscape phones, small laptops): a 16:9 video stacked
       on top eats nearly the whole modal height and buries the title and
       details below it, so put the media beside the text instead. Only the
       text column scrolls; the media stays put. */
    @media (max-height: 560px) and (min-width: 640px) {
      .modal {
        max-width: 920px;
        max-height: 92dvh;
        display: grid;
        grid-template-columns: minmax(0, 11fr) minmax(0, 12fr);
        overflow: hidden;
      }
      .modal-image, .modal-video {
        grid-column: 1;
        grid-row: 1;
        align-self: start;
        border-radius: 20px 0 0 0;
      }
      .modal-body {
        grid-column: 2;
        grid-row: 1;
        max-height: 92dvh;
        overflow-y: auto;
        padding: 24px 26px;
      }
    }

    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 2;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: none;
      background: rgba(0,0,0,0.4);
      color: #fff;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .modal-close:hover { background: rgba(0,0,0,0.6); }

    .modal-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-position: center;
      border-radius: 20px 20px 0 0;
    }
    /* Video takes over the same slot as the static image when a project has
       one — see the script toggling image vs. video display on open. */
    .modal-video {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 20px 20px 0 0;
      overflow: hidden;
      background: #000;
    }
    .modal-video:empty { display: none; }
    /* :global — the iframe, the tag pills, and the link pills below are all
       created at runtime by the modal script, so they never get Astro's
       scoping attribute and a plain scoped selector wouldn't match them. */
    .modal-video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .modal-body { padding: 28px; }
    .modal-body h2 { font-size: 1.4rem; margin-bottom: 14px; }
    .modal-body p { color: var(--text); margin-bottom: 22px; line-height: 1.65; }
    .modal-body dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 0; }
    .modal-body dt { font-family: var(--font-display); font-size: 0.78rem; color: var(--muted); margin-bottom: 4px; }
    .modal-body dd { margin: 0; font-size: 0.9rem; }

    .modal-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    .modal-links:empty { display: none; }
    .modal-links :global(a) {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--violet);
      background: var(--violet-soft);
      border-radius: 999px;
      padding: 8px 16px;
      transition: background 0.15s ease;
    }
    .modal-links :global(a:hover) { background: rgba(124, 92, 255, 0.5); }

    /* Optional per-project write-up — the Markdown body of its .md file,
       compiled to HTML at build time. Only present (and only takes up
       space) when a project actually has body content below its frontmatter. */
    .modal-docs {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
      color: var(--text);
      font-size: 0.92rem;
      line-height: 1.7;
    }
    .modal-docs:empty { display: none; }
    .modal-docs :global(h2) { font-size: 1.05rem; margin: 0 0 10px; }
    .modal-docs :global(h2:not(:first-child)) { margin-top: 20px; }
    .modal-docs :global(p) { margin: 0 0 14px; color: var(--text); }
    .modal-docs :global(ul) { margin: 0 0 14px; padding-left: 20px; list-style: disc; }
    .modal-docs :global(li) { margin-bottom: 6px; }
    .modal-docs :global(code) {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 1px 6px;
      font-size: 0.85em;
    }
    .modal-docs :global(a) { color: var(--violet); text-decoration: underline; }
    .modal-docs :global(img) {
      display: block;
      width: 100%;
      height: auto;
      margin: 18px 0;
      border-radius: 12px;
      border: 1px solid var(--line);
    }

    @media (max-width: 720px) {
      .project-list::before, .timeline-dot { display: none; }
      .timeline-row[data-side="left"], .timeline-row[data-side="right"] { justify-content: flex-start; }
      .project, .timeline-row[data-side="right"] .project { flex-direction: column; width: 100%; }
      .timeline-row[data-side="left"] .project:not(.in-view),
      .timeline-row[data-side="right"] .project:not(.in-view) { transform: translateY(24px); }
      .project.in-view { transform: translateY(0); }
      .project-thumb { min-height: 200px; }
      .project-body { padding: 26px; }
      .modal-body dl { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".project");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        const tag = btn.dataset.tag;
        cards.forEach((c) => {
          const tags = c.dataset.tags?.split(",") ?? [];
          const show = tag === "All" || tags.includes(tag ?? "");
          // Hide the whole timeline row, not just the card, so a filtered-out
          // project doesn't leave an orphaned dot sitting on the spine.
          const row = c.closest<HTMLElement>(".timeline-row");
          if (row) row.style.display = show ? "" : "none";
        });
        // Re-alternate sides over whatever is still visible, so the zigzag
        // holds after filtering instead of rows keeping their original side
        // and stacking two lefts (or rights) in a row.
        let i = 0;
        document.querySelectorAll<HTMLElement>(".timeline-row").forEach((row) => {
          if (row.style.display === "none") return;
          row.dataset.side = i++ % 2 === 0 ? "left" : "right";
        });
      });
    });

    // Each project starts pushed out toward its page edge (see the
    // translateX rest state in CSS) and slides in to the timeline the first
    // time it scrolls into view.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2, rootMargin: "0px 0px -60px 0px" }
    );
    cards.forEach((c) => observer.observe(c));
  </script>

  <script define:vars={{ projects }}>
    const cards = document.querySelectorAll(".project");
    const overlay = document.getElementById("modalOverlay");
    const modalImage = document.getElementById("modalImage");
    const modalVideo = document.getElementById("modalVideo");
    const modalTitle = document.getElementById("modalTitle");
    const modalDetails = document.getElementById("modalDetails");
    const modalTags = document.getElementById("modalTags");
    const modalRole = document.getElementById("modalRole");
    const modalStack = document.getElementById("modalStack");
    const modalStudio = document.getElementById("modalStudio");
    const modalStudioRow = document.getElementById("modalStudioRow");
    const modalPlatform = document.getElementById("modalPlatform");
    const modalPlatformRow = document.getElementById("modalPlatformRow");
    const modalLinks = document.getElementById("modalLinks");
    const modalDocs = document.getElementById("modalDocs");
    const closeBtn = document.getElementById("modalClose");

    function openModal(project) {
      modalTitle.textContent = project.title;
      modalDetails.textContent = project.details;
      modalRole.textContent = project.role;
      modalStack.textContent = project.stack;
      modalStudio.textContent = project.studio ?? "";
      modalStudioRow.hidden = !project.studio;
      modalPlatform.textContent = project.platform ?? "";
      modalPlatformRow.hidden = !project.platform;
      modalTags.innerHTML = "";
      project.tags.forEach((t) => {
        const span = document.createElement("span");
        span.className = "tag";
        span.textContent = t;
        modalTags.appendChild(span);
      });

      // A video replaces the static image in the same slot when present.
      if (project.video) {
        // referrerpolicy: YouTube refuses to play (error 153) when the embed
        // request arrives without a Referer, so state the policy explicitly
        // rather than inheriting whatever the browser or an extension decides.
        modalVideo.innerHTML = `<iframe src="${project.video}" title="${project.title}" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"></iframe>`;
        modalImage.style.display = "none";
      } else {
        modalVideo.innerHTML = "";
        modalImage.style.backgroundImage = project.image ? `url(${project.image})` : "";
        modalImage.style.display = project.image ? "" : "none";
      }

      modalLinks.innerHTML = "";
      (project.links ?? []).forEach((link) => {
        const a = document.createElement("a");
        a.href = link.href;
        a.target = "_blank";
        a.rel = "noopener";
        a.textContent = `${link.label} →`;
        modalLinks.appendChild(a);
      });

      // Markdown body, pre-compiled to HTML at build time — trusted content
      // since it's authored in the repo, not user input.
      modalDocs.innerHTML = project.docsHtml || "";

      overlay.classList.add("open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    }

    function closeModal() {
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    cards.forEach((card) => {
      const openThis = () => {
        const project = projects.find((p) => p.id === card.dataset.projectId);
        if (project) openModal(project);
      };
      card.addEventListener("click", openThis);
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openThis();
        }
      });
    });

    closeBtn.addEventListener("click", closeModal);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  </script>
</Layout>
