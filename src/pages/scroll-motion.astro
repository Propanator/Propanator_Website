---
const chapters = [
  {
    id: "one",
    tag: "Chapter 01",
    title: "The quick fox builds engines",
    body: "Lorem ipsum dolor sit amet, this is placeholder copy standing in for real project text. It exists purely to test how much visual weight a paragraph carries while it's in motion — replace with the real write-up once the effect feels right.",
    accent: "violet",
    dir: 1,
    media: { type: "image", src: "https://picsum.photos/id/1015/900/900" },
  },
  {
    id: "two",
    tag: "Chapter 02",
    title: "Somewhere between vertex and pixel",
    body: "More filler text, longer this time, just to see how a bigger paragraph behaves mid-scroll — does it stay readable while sliding, or does the motion need to slow down once there's more to read? Test it and see.",
    accent: "teal",
    dir: -1,
    media: { type: "image", src: "https://picsum.photos/id/1025/900/900" },
  },
  {
    id: "three",
    tag: "Chapter 03",
    title: "Ship it, then iterate",
    body: "Short one. Placeholder only.",
    accent: "magenta",
    dir: 1,
    media: { type: "video", src: "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" },
  },
  {
    id: "four",
    tag: "Chapter 04",
    title: "Every frame is a decision",
    body: "Final test block — random copy about nothing in particular, just here to fill space and give the motion something to carry across the viewport as you scroll past.",
    accent: "violet",
    dir: -1,
    media: { type: "image", src: "https://picsum.photos/id/1039/900/900" },
  },
  {
    id: "mochi",
    tag: "R&D / Prototype",
    title: "Mochi — a data-driven emotional companion",
    body: "A small skeletal companion character driven entirely by data assets rather than hand-authored animation trees. Six emotional profiles — Neutral, Calm, Excited, Annoyed, Defensive, Playful — each own their own socket-level micro-animation behavior, so the character's ears, mouth, and belly react differently depending on its current mood, not just a fixed idle loop.",
    accent: "teal",
    dir: 1,
    media: { type: "video-scrub", src: "/videos/mochi-demo.mp4" },
    panel: {
      src: "/images/mochi-data-asset.png",
      caption: "EmotionalProfile data asset — socket groups & trigger config",
    },
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scroll motion prototype · Propane Games</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="/projects" class="back-link">← Back to site</a>
    <a href="/scroll-test" class="alt-link">View the fade-in version →</a>
    <label class="motion-toggle">
      <input type="checkbox" id="motionToggle" />
      Reduce motion
    </label>
    <div id="debugReadout"></div>

    <nav class="dot-nav" aria-label="Chapter navigation">
      {chapters.map((c) => (
        <button class="dot" data-target={c.id} aria-label={`Go to ${c.title}`}>
          <span class="dot-tooltip">{c.title}</span>
        </button>
      ))}
    </nav>

    <main>
      {chapters.map((c, i) => (
        <section class="chapter" id={c.id} data-index={i} data-dir={c.dir}>
          <div class="chapter-sticky">
            <div class="parallax-bg" data-accent={c.accent}></div>
            <div class="chapter-visual" data-accent={c.accent}>
              {c.media.type === "video" ? (
                <video src={c.media.src} autoplay muted loop playsinline></video>
              ) : c.media.type === "video-scrub" ? (
                <video class="scrub-video" src={c.media.src} muted playsinline preload="auto"></video>
              ) : (
                <img src={c.media.src} alt={c.title} loading="lazy" />
              )}
              <span class="chapter-number">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="chapter-text">
              <span class="chapter-tag">{c.tag}</span>
              <h2 class="chapter-title">{c.title}</h2>
              <p class="chapter-body">{c.body}</p>
              {c.panel && (
                <figure class="chapter-panel">
                  <img src={c.panel.src} alt={c.panel.caption} loading="lazy" />
                  <figcaption>{c.panel.caption}</figcaption>
                </figure>
              )}
            </div>
          </div>
        </section>
      ))}
    </main>

    <style is:global>
      * { box-sizing: border-box; }
      html { background: #0e0e16; }
      body {
        margin: 0;
        color: #f1f0f7;
        font-family: "Inter", sans-serif;
        background: #0e0e16;
      }
      h2 { font-family: "Space Grotesk", sans-serif; font-weight: 600; margin: 0; }

      .back-link, .alt-link {
        position: fixed;
        top: 24px;
        z-index: 20;
        color: #9a96ac;
        text-decoration: none;
        font-size: 0.85rem;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(6px);
      }
      .back-link { left: 24px; }
      .alt-link { right: 24px; }
      .back-link:hover, .alt-link:hover { color: #f1f0f7; }

      #debugReadout {
        position: fixed;
        bottom: 16px;
        left: 16px;
        z-index: 50;
        color: #0f0;
        background: #000;
        font-family: monospace;
        font-size: 12px;
        padding: 8px 12px;
        white-space: pre;
        line-height: 1.5;
      }

      .motion-toggle {
        position: fixed;
        top: 64px;
        left: 24px;
        z-index: 50;
        color: #f1f0f7;
        font-size: 0.85rem;
        background: rgba(0,0,0,0.5);
        padding: 8px 14px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
      }

      /* This class does what the OS-level prefers-reduced-motion media query used to do,
         but is now toggled manually via the checkbox above — so you can test both states
         without changing any system setting. */
      html.reduce-motion .chapter-tag,
      html.reduce-motion .chapter-title,
      html.reduce-motion .chapter-body,
      html.reduce-motion .chapter-visual,
      html.reduce-motion .chapter-text,
      html.reduce-motion .parallax-bg {
        opacity: 1 !important;
        transform: none !important;
      }

      .chapter {
        height: 240vh;
        position: relative;
        --f-tag: clamp(0, calc(var(--progress, 0) / 0.16), 1);
        --f-title: clamp(0, calc((var(--progress, 0) - 0.08) / 0.22), 1);
        --f-body: clamp(0, calc((var(--progress, 0) - 0.2) / 0.22), 1);
        --f-out: clamp(0, calc((var(--progress, 0) - 0.8) / 0.2), 1);
      }

      .chapter-sticky {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6vw;
        padding: 0 8vw;
        overflow: hidden;
      }

      /* Slow-moving background layer — the parallax "depth" cue */
      .parallax-bg {
        position: absolute;
        inset: -10%;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.35;
        transform: translateY(calc((var(--progress, 0) - 0.5) * 25vh));
        pointer-events: none;
      }
      .parallax-bg[data-accent="violet"] { background: radial-gradient(circle, #7c5cff, transparent 60%); }
      .parallax-bg[data-accent="teal"] { background: radial-gradient(circle, #22d3b8, transparent 60%); }
      .parallax-bg[data-accent="magenta"] { background: radial-gradient(circle, #ff5ca8, transparent 60%); }

      /* The visual travels the full width of the viewport across the chapter's scroll.
         --travel is a full length (e.g. 60vw or -60vw) set directly by JS per chapter,
         so this calc() only ever multiplies one variable by a plain number — no
         var()-times-var() multiplication, no chained transform functions. */
      .chapter-visual {
        flex: 0 0 auto;
        width: min(34vw, 380px);
        height: min(34vw, 380px);
        border-radius: 28px;
        display: flex;
        align-items: flex-end;
        padding: 28px;
        opacity: calc(1 - var(--f-out) * 1.2);
        transform: translateX(calc((var(--progress, 0) - 0.5) * var(--travel, 60vw)));
        overflow: hidden;
        position: relative;
      }
      .chapter-visual img,
      .chapter-visual video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
      }
      .chapter-visual .chapter-number {
        position: relative;
        z-index: 1;
        text-shadow: 0 2px 12px rgba(0,0,0,0.6);
      }
      .chapter-visual[data-accent="violet"] { background: linear-gradient(135deg, #7c5cff, #3a2b8c); }
      .chapter-visual[data-accent="teal"] { background: linear-gradient(135deg, #22d3b8, #146b5c); }
      .chapter-visual[data-accent="magenta"] { background: linear-gradient(135deg, #ff5ca8, #7a2652); }
      .chapter-number {
        font-family: "Space Grotesk", sans-serif;
        font-size: 1.4rem;
        font-weight: 600;
        color: rgba(255,255,255,0.6);
      }

      /* Text drifts the opposite direction from the visual, slower, for a crossing parallax feel */
      .chapter-text {
        max-width: 420px;
        transform: translateX(calc((0.5 - var(--progress, 0)) * var(--travel-text, 18vw)));
      }

      .chapter-tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 500;
        color: #9a96ac;
        border: 1px solid #2a2836;
        border-radius: 999px;
        padding: 5px 14px;
        margin-bottom: 16px;
        opacity: var(--f-tag);
      }

      .chapter-title {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        margin-bottom: 14px;
        opacity: calc(var(--f-title) - var(--f-out));
        transform: translateY(calc((1 - var(--f-title)) * 40px));
      }

      .chapter-body {
        color: #9a96ac;
        line-height: 1.6;
        opacity: calc(var(--f-body) - var(--f-out));
        transform: translateY(calc((1 - var(--f-body)) * 30px));
      }

      /* Small inline screenshot that rides along with the text column,
         styled like an editor panel rather than the big sliding hero visual */
      .chapter-panel {
        margin: 18px 0 0;
        opacity: calc(var(--f-body) - var(--f-out));
        transform: translateY(calc((1 - var(--f-body)) * 20px));
      }
      .chapter-panel img {
        width: 100%;
        max-width: 340px;
        display: block;
        border-radius: 10px;
        border: 1px solid #2a2836;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
      }
      .chapter-panel figcaption {
        margin-top: 8px;
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.72rem;
        color: #6f6b80;
        letter-spacing: 0.02em;
      }

      .dot-nav {
        position: fixed;
        right: 32px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 20;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .dot {
        position: relative;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: transparent;
        border: 1.5px solid #4a4658;
        padding: 0;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }
      .dot:hover { transform: scale(1.3); border-color: #f1f0f7; }
      .dot.active {
        background: linear-gradient(135deg, #7c5cff, #ff5ca8);
        border-color: transparent;
        transform: scale(1.3);
      }
      .dot-tooltip {
        position: absolute;
        right: 22px;
        top: 50%;
        transform: translateY(-50%);
        white-space: nowrap;
        font-size: 0.78rem;
        color: #f1f0f7;
        background: #1c1b28;
        border: 1px solid #2a2836;
        padding: 5px 10px;
        border-radius: 6px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s ease;
      }
      .dot:hover .dot-tooltip { opacity: 1; }

      @media (max-width: 780px) {
        .chapter { height: 260vh; }
        .chapter-sticky { flex-direction: column; justify-content: center; gap: 32px; text-align: center; }
        .chapter-visual { width: 50vw; height: 50vw; }
        .chapter-text { transform: none; }
        .dot-nav { right: 14px; gap: 14px; }
        .dot-tooltip { display: none; }
        .alt-link { display: none; }
      }

      /* Reduced-motion handling now lives in the .reduce-motion class rule above,
         driven by the toggle checkbox (initialized from the OS setting on load). */
    </style>

    <script>
      const chapters = document.querySelectorAll<HTMLElement>(".chapter");
      const dots = document.querySelectorAll<HTMLButtonElement>(".dot");

      chapters.forEach((chapter) => {
        const dir = chapter.dataset.dir === "-1" ? -1 : 1;
        chapter.style.setProperty("--travel", `${60 * dir}vw`);
        chapter.style.setProperty("--travel-text", `${18 * dir}vw`);

        const scrubVideo = chapter.querySelector<HTMLVideoElement>(".scrub-video");
        scrubVideo?.addEventListener("ended", () => {
          scrubVideo.currentTime = Math.max(0, scrubVideo.duration - 0.1);
        });
      });

      const motionToggle = document.getElementById("motionToggle") as HTMLInputElement | null;
      if (motionToggle) {
        // No more OS/browser auto-detection — starts with motion on, visitor controls it directly.
        motionToggle.checked = false;
        document.documentElement.classList.toggle("reduce-motion", motionToggle.checked);
        motionToggle.addEventListener("change", () => {
          document.documentElement.classList.toggle("reduce-motion", motionToggle.checked);
        });
      }

      function update() {
        let activeIndex = 0;
        const viewportMid = window.innerHeight / 2;
        const readout = document.getElementById("debugReadout");
        const lines: string[] = [];

        chapters.forEach((chapter, i) => {
          const rect = chapter.getBoundingClientRect();
          const scrollDistance = rect.height - window.innerHeight;
          const progress = scrollDistance > 0
            ? Math.min(Math.max(-rect.top / scrollDistance, 0), 1)
            : 0;
          chapter.style.setProperty("--progress", progress.toString());
          const travel = getComputedStyle(chapter).getPropertyValue("--travel").trim();
          lines.push(`ch${i}: progress=${progress.toFixed(2)} travel=${travel || "unset"}`);

          // Scroll-scrub any video in this chapter: 0% scrolled = frame 0,
          // 100% scrolled = last frame. No autoplay — playback position IS the scroll position.
          // Clamped just short of the true end: some browsers (Firefox especially) mark a
          // paused video "ended" once currentTime hits duration exactly, and stop repainting
          // on further seeks — even though currentTime keeps updating under the hood.
          const scrubVideo = chapter.querySelector<HTMLVideoElement>(".scrub-video");
          if (scrubVideo) {
            if (scrubVideo.readyState >= 1 && scrubVideo.duration) {
              const target = Math.min(progress * scrubVideo.duration, scrubVideo.duration - 0.05);
              if (Math.abs(scrubVideo.currentTime - target) > 0.02) {
                scrubVideo.currentTime = target;
              }
            }
            lines.push(
              `  scrub: readyState=${scrubVideo.readyState} duration=${scrubVideo.duration} currentTime=${scrubVideo.currentTime.toFixed(2)} ended=${scrubVideo.ended}`
            );
          }

          if (rect.top <= viewportMid && rect.bottom >= viewportMid) {
            activeIndex = i;
          }
        });

        if (readout) readout.textContent = lines.join("\n");
        dots.forEach((dot, i) => dot.classList.toggle("active", i === activeIndex));
        requestAnimationFrame(update);
      }
      requestAnimationFrame(update);

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const target = document.getElementById(dot.dataset.target ?? "");
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    </script>
  </body>
</html>
