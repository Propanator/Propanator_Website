---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Senior Unreal Engine developer specializing in VR, simulation, and AI-assisted content pipelines." } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/ai", label: "AI" },
  { href: "/contact", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · Propane Games</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>

    <header class="site-header">
      <a href="/" class="mark">Propane<span>Games</span></a>
      <nav>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} class="navlink" aria-current={currentPath === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Propane Games — Louis-Charles La Manna</p>
      <div class="footer-links">
        <a href="mailto:louischarles.lamanna@icloud.com">Email</a>
        <a href="https://www.upwork.com/freelancers/~01d363ad82ef101190" target="_blank" rel="noopener">Upwork</a>
        <a href="https://www.linkedin.com/in/louis-charles-la-manna-harvey-244191164/" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #0e0e16;
        --panel: #16151f;
        --panel-raised: #1c1b28;
        --line: #2a2836;
        --violet: #7c5cff;
        --violet-soft: rgba(124, 92, 255, 0.35);
        --magenta: #ff5ca8;
        --teal: #22d3b8;
        --teal-soft: rgba(34, 211, 184, 0.35);
        --text: #f1f0f7;
        --muted: #9a96ac;
        --font-display: "Space Grotesk", sans-serif;
        --font-body: "Inter", sans-serif;
        --radius: 16px;
      }

      * { box-sizing: border-box; }

      html { background: var(--bg); color-scheme: dark; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.15;
        margin: 0;
      }

      p { margin: 0; }
      a { color: inherit; text-decoration: none; }
      ul { list-style: none; margin: 0; padding: 0; }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 1;
      }

      .glow {
        position: fixed;
        z-index: 0;
        border-radius: 50%;
        filter: blur(90px);
        pointer-events: none;
        opacity: 0.55;
        animation: drift 14s ease-in-out infinite alternate;
      }
      .glow-a {
        top: -220px;
        left: -160px;
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, var(--violet) 0%, transparent 70%);
      }
      .glow-b {
        top: -160px;
        right: -200px;
        width: 460px;
        height: 460px;
        background: radial-gradient(circle, var(--magenta) 0%, transparent 70%);
        animation-delay: -6s;
      }
      @keyframes drift {
        from { transform: translate(0, 0) scale(1); }
        to { transform: translate(20px, 30px) scale(1.08); }
      }
      .site-header {
        max-width: 960px;
        margin: 0 auto;
        padding: 28px 24px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
      }

      .mark {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
      }
      .mark span { color: var(--violet); }

      .site-header nav ul { display: flex; gap: 6px; }

      .navlink {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--muted);
        padding: 8px 16px;
        border-radius: 999px;
        transition: background 0.18s ease, color 0.18s ease;
      }
      .navlink:hover { color: var(--text); background: var(--panel-raised); }
      .navlink[aria-current="page"] {
        color: var(--text);
        background: linear-gradient(135deg, var(--violet-soft), rgba(255, 92, 168, 0.25));
      }

      .site-footer {
        max-width: 960px;
        margin: 90px auto 0;
        padding: 28px 24px 40px;
        border-top: 1px solid var(--line);
        position: relative;
        z-index: 1;
      }
      .site-footer p { color: var(--muted); font-size: 0.85rem; margin-top: 24px; }
      .footer-links { display: flex; gap: 20px; margin-top: 10px; }
      .footer-links a { font-size: 0.85rem; color: var(--muted); }
      .footer-links a:hover { color: var(--violet); }

      @media (max-width: 640px) {
        .site-header { padding-top: 20px; }
        .site-header nav ul { gap: 4px; }
        .navlink { padding: 7px 12px; font-size: 0.85rem; }
      }
    </style>
  </body>
</html>
