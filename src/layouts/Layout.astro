---
import { site, contactChannels } from "../data/site";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Senior Unreal Engine developer specializing in VR, simulation, and games." } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  // AI page is parked for now — src/pages/ai.astro is dev-only until it's ready.
  { href: "/contact", label: "Contact" },
];
const currentPath = Astro.url.pathname;

// Social previews (LinkedIn, Discord, iMessage, Slack...) and search engines.
// The card is public/images/og-card.jpg; regenerate it if the portrait changes.
const pageTitle = `${title} · ${site.name}`;
const shareTitle = currentPath === "/" ? `${site.name} · ${site.owner}` : pageTitle;
const canonical = new URL(currentPath, Astro.site).href;
const shareImage = new URL("/images/og-card.jpg", Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.owner}, ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>

    <header class="site-header">
      <a href="/" class="mark">Propane<span>Games</span></a>
      <nav>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} class="navlink" aria-current={currentPath === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{site.name} — <span class="nowrap">{site.owner}</span></p>
      <div class="footer-links">
        {contactChannels.map((c) => (
          <a href={c.href} target={c.external ? "_blank" : undefined} rel={c.external ? "noopener" : undefined}>
            {c.label}
          </a>
        ))}
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #0e0e16;
        --panel: #16151f;
        --panel-raised: #1c1b28;
        --line: #2a2836;
        --violet: #7c5cff;
        --violet-soft: rgba(124, 92, 255, 0.35);
        --magenta: #ff5ca8;
        --gold: #ffd45c;
        --gold-deep: #ffb020;
        --plum: #3a123a;
        --teal: #22d3b8;
        --teal-soft: rgba(34, 211, 184, 0.35);
        --text: #f1f0f7;
        --muted: #9a96ac;
        --font-display: "Unbounded", sans-serif;
        --font-body: "Plus Jakarta Sans", sans-serif;
        --radius: 16px;
      }

      * { box-sizing: border-box; }

      html { background: var(--bg); color-scheme: dark; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.15;
        margin: 0;
      }

      p { margin: 0; }
      a { color: inherit; text-decoration: none; }
      ul { list-style: none; margin: 0; padding: 0; }

      main {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 1;
      }

      /* Shared page-heading pieces, so every page's intro reads the same. */
      .eyebrow {
        font-family: var(--font-display);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--violet);
        margin-bottom: 14px;
      }
      .page-intro { padding: 64px 0 36px; max-width: 600px; }
      .page-intro h1 { font-size: clamp(1.9rem, 3.6vw, 2.4rem); margin-bottom: 14px; }
      .page-intro h1 span { color: var(--magenta); }
      .page-intro p { color: var(--muted); }

      .glow {
        position: fixed;
        z-index: 0;
        border-radius: 50%;
        filter: blur(90px);
        pointer-events: none;
        opacity: 0.55;
        animation: drift 14s ease-in-out infinite alternate;
      }
      .glow-a {
        top: -220px;
        left: -160px;
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, var(--violet) 0%, transparent 70%);
      }
      .glow-b {
        top: -160px;
        right: -200px;
        width: 460px;
        height: 460px;
        background: radial-gradient(circle, var(--magenta) 0%, transparent 70%);
        animation-delay: -6s;
      }
      @keyframes drift {
        from { transform: translate(0, 0) scale(1); }
        to { transform: translate(20px, 30px) scale(1.08); }
      }
      .site-header {
        max-width: 960px;
        margin: 0 auto;
        padding: 28px 24px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        position: relative;
        z-index: 1;
      }

      .mark {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
      }
      .mark span { color: var(--violet); }

      .site-header nav ul { display: flex; gap: 6px; }

      .navlink {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--muted);
        padding: 8px 16px;
        border-radius: 999px;
        transition: background 0.18s ease, color 0.18s ease;
      }
      .navlink:hover { color: var(--text); background: var(--panel-raised); }
      .navlink[aria-current="page"] {
        color: var(--text);
        background: linear-gradient(135deg, var(--violet-soft), rgba(255, 92, 168, 0.25));
      }

      .site-footer {
        max-width: 960px;
        margin: 90px auto 0;
        padding: 28px 24px 40px;
        border-top: 1px solid var(--line);
        position: relative;
        z-index: 1;
      }
      .site-footer p { color: var(--muted); font-size: 0.85rem; margin-top: 24px; }
      .site-footer .nowrap { white-space: nowrap; }
      .footer-links { display: flex; gap: 20px; margin-top: 10px; }
      .footer-links a { font-size: 0.85rem; color: var(--muted); }
      .footer-links a:hover { color: var(--violet); }

      @media (max-width: 640px) {
        .site-header { padding-top: 20px; }
        .site-header nav ul { gap: 4px; }
        .navlink { padding: 7px 12px; font-size: 0.85rem; }
      }
    </style>
  </body>
</html>
